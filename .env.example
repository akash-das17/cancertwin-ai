# CancerTwin AI Configuration
APP_NAME="CancerTwin AI"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY="./data/chromadb"
CHROMA_COLLECTION_NAME="oncology_guidelines"

# LLM Orchestrator Provider (options: 'gemini', 'openai', 'mock')
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_MODEL="gemini-1.5-flash"

# Token Budget Controls (Input & Output)
LLM_MAX_INPUT_TOKENS=2048
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
